# A dedicated PayPal sandbox REST app for Tamper (NOT CollectPilot's or HoldSlot's app,
# so its webhook feed stays separate). Create at developer.paypal.com → Apps & Credentials → Sandbox.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ANTHROPIC_API_KEY=

# Gate for the live-Claude toggle on the dashboard (owner-only spend).
TAMPER_PASSCODE=

# Public base URL of this deployment (Render sets RENDER_EXTERNAL_URL itself). When PayPal's
# webhook for this app posts to <url>/api/paypal/webhook, the replay check uses PayPal's own
# signed deliveries; otherwise it replays a clearly labelled synthetic event.
TAMPER_PUBLIC_URL=
